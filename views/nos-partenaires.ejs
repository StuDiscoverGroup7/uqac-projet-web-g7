<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StuDiscover - Nos partenaires</title>

    <link rel="stylesheet" href="/style/global.css">

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="flex flex-col min-h-screen">

    <%- include('partials/header') %>

    <main class="flex-grow">
            
        <section class="bg-white py-10 px-4 text-center font-sans border-b border-gray-100">
            <div class="max-w-2xl mx-auto">
                <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-3 tracking-tight">
                    Nos Partenaires
                </h1>
                <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                    Découvrez les organisations qui nous soutiennent pour vous offrir le meilleur.
                </p>
            </div>
        </section>

        <section class="bg-gray-100 py-10 px-4">

            <div class="container mx-auto max-w-7xl">
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

                    <div class="bg-white block border border-gray-200 rounded-xl shadow overflow-hidden hover:shadow-lg transition-shadow">
                        <a href="#" class="block bg-white">
                            <img class="w-full h-32 object-contain p-4" src="/img/logo-partners/logoDesjardins.png" alt="Desjardins" />
                        </a>
                        <div class="p-6 text-center border-t border-gray-100">
                            <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">Desjardins</h5>
                            <p class="text-gray-600 text-sm">Solutions financières pour étudiant</p>
                        </div>
                    </div>

                    <div class="bg-white block border border-gray-200 rounded-xl shadow overflow-hidden hover:shadow-lg transition-shadow">
                        <a href="#" class="block bg-white">
                            <img class="w-full h-32 object-contain p-4" src="/img/logo-partners/logoRenaud-Bray.png" alt="Renaud-Bray" />
                        </a>
                        <div class="p-6 text-center border-t border-gray-100">
                            <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">Librairie Renaud-Bray</h5>
                            <p class="text-gray-600 text-sm">Réductions exclusives sur les livres</p>
                        </div>
                    </div>

                    <div class="bg-white block border border-gray-200 rounded-xl shadow overflow-hidden hover:shadow-lg transition-shadow">
                        <a href="#" class="block bg-white">
                            <img class="w-full h-32 object-contain p-4" src="/img/logo-partners/logoMicrosoft.png" alt="Microsoft" />
                        </a>
                        <div class="p-6 text-center border-t border-gray-100">
                            <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">Microsoft</h5>
                            <p class="text-gray-600 text-sm">Outils et ressources numériques</p>
                        </div>
                    </div>

                    <div class="bg-white block border border-gray-200 rounded-xl shadow overflow-hidden hover:shadow-lg transition-shadow">
                        <a href="#" class="block bg-white">
                            <img class="w-full h-32 object-contain p-4" src="/img/logo-partners/logoUniversitéLaval.png" alt="UniversitéLaval" />
                        </a>
                        <div class="p-6 text-center border-t border-gray-100">
                            <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">Université de Laval</h5>
                            <p class="text-gray-600 text-sm">Partenaire académique majeur</p>
                        </div>
                    </div>

                </div> 
            </div> 
        </section>

    </main>

</body>
</html>