<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mes offres - StuDiscover</title>
    
    <link rel="stylesheet" href="/style/global.css" />
    <link rel="stylesheet" href="/style/offers/my-offers.css" />
  </head>

  <body>
    <%- include('../partials/header') %>

    <main class="container">

      <section class="header-actions">
        <h1>Mes offres</h1>
        <a href="/offers/create" class="btn-create">+ Nouvelle offre</a>
      </section>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (offers.length === 0) { %>

        <section class="empty-state">
          <p>Aucune offre pour l'instant.</p>
          <a href="/offers/create" class="btn-create">Créer ma première offre</a>
        </section>

      <% } else { %>

        <section class="offers-grid">
          <% offers.forEach(offer => { %>
            <div class="offer-card">
              <div class="card-top">
                <h3><%= offer.title %></h3>
                <span class="badge <%= offer.type === 'job' ? 'bg-blue' : 'bg-red' %>">
                  <%= offer.type %>
                </span>
              </div>

              <div class="card-content">
                <p class="address"><%= offer.address %></p>
                <p class="desc"><%= offer.description %></p>
              </div>

              <div class="card-actions">
                <a href="/offers/<%= offer.id %>/edit" class="action-btn edit">Modifier</a>
                <a href="/offers/<%= offer.id %>/delete" class="action-btn delete">Supprimer</a>
              </div>
            </div>
          <% }); %>
        </section>

      <% } %>

    </main>
  </body>
</html>
