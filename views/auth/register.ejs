<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inscription - StuDiscover</title>
    
    <link rel="stylesheet" href="/style/global.css" />
    <link rel="stylesheet" href="/style/auth/auth.css" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include('../partials/header') %>
    
    <main class="auth-container">
      <section class="auth-card">
        <h2>Créer un compte</h2>
        
        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>
        
        <form method="post" action="/register">
          <label class="form-group">
            Nom complet
            <input type="text" name="name" value="<%= values.name || '' %>" placeholder="Ex: Jean Dupont" />
          </label>
          
          <label class="form-group">
            Email
            <input
              type="email"
              name="email"
              required
              value="<%= values.email || '' %>"
              placeholder="Ex: etudiant@uqac.ca"
            />
          </label>
          
          <label class="form-group">
            Mot de passe
            <input type="password" name="password" required placeholder="••••••••" />
          </label>
          
          <button type="submit" class="btn btn-primary btn-full">Créer mon compte</button>
        </form>
        
        <p class="auth-footer">
          Déjà inscrit ? <a href="/login">Se connecter</a>
        </p>
      </section>
    </main>
  </body>
</html>